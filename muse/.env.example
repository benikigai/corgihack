# Your Agent37 API key, from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=

# Monid access for the agent's research and media-generation tools.
# Inject through Instacloud secrets; automatically installed in the agent's CLI store.
MONID_API_KEY=

# Signs the visitor cookie that maps a browser to its own agent. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Private single-owner deployment; required in production (16+ characters).
# All devices signed in with this password share the same agent.
MUSE_ACCESS_PASSWORD=

# Persistent volume location in the Instacloud container.
# DATA_DIR=/data

# The URL agents use to reach this server when they message the user first. Agents run in
# the cloud, so localhost won't work: deploy this app somewhere public, or for local dev run
#   cloudflared tunnel --url http://localhost:3104
# in another terminal and paste the https URL it prints. Leave it empty and everything
# works except notifications from the agent.
PUBLIC_URL=

# Optional overrides, the defaults are right for production
# AGENT37_API_BASE=https://api.agent37.com
# AGENT37_APP_DOMAIN=agent37.app
# PORT=3104
