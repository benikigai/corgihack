# Copy into ~/.hermes/.env on the Agent37 box. Never commit real values.

# Meta: corgi-agent system user token (Employee role) with ads_mcp_management,
# ads_management, ads_read, business_management. Stored in the vault.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_0000000000000000
META_PAGE_ID=0000000000000000

# Option C fallback only (pipeboard.co/api-tokens)
PIPEBOARD_API_TOKEN=

# Option B only: your Meta app (developers.facebook.com)
META_APP_ID=0000000000000000
META_APP_SECRET=

MONID_API_KEY=
SUPABASE_ACCESS_TOKEN=
