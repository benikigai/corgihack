# Copy into ~/.hermes/.env on the Agent37 box. Never commit real values.

# Meta: system user token with ads_read + ads_management (Business Settings > System users)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_
META_PAGE_ID=

# Option C fallback only (pipeboard.co/api-tokens)
PIPEBOARD_API_TOKEN=

# Option B only: your Meta app (developers.facebook.com)
META_APP_ID=
META_APP_SECRET=

MONID_API_KEY=
SUPABASE_ACCESS_TOKEN=
